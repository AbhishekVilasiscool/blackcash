#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks..."

# Run typecheck
echo "→ TypeScript typecheck..."
npm run typecheck --silent
if [ $? -ne 0 ]; then
  echo "❌ Typecheck failed"
  exit 1
fi

# Run tests
echo "→ Tests..."
npm test --silent
if [ $? -ne 0 ]; then
  echo "❌ Tests failed"
  exit 1
fi

echo "✅ Pre-commit checks passed"